+            if value in (None, ""):
+                return default
+            try:
+                parsed = int(value)
+            except (TypeError, ValueError):
+                return default
+            return parsed if parsed > 0 else default
+
+        try:
+            context_config = _agent_cfg.get("context", {}) or {}
